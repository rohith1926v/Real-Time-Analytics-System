COMPOSE_PROJECT_NAME=streaming_analytics_system

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
ENVIRONMENT=development
PROJECT_NAME=Real-Time Streaming Analytics Platform
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# Database placeholders for later phases
DATABASE_URL=postgresql+psycopg://analytics:analytics@postgres:5432/analytics
REDIS_URL=redis://redis:6379/0

# Kafka telemetry runtime
KAFKA_BOOTSTRAP_SERVERS=streaming-analytics-kafka:29092
KAFKA_CONSUMER_GROUP=streaming-analytics-telemetry-consumers
EVENT_RATE_PER_SECOND=5
ANOMALY_RATE=0.05
PRODUCER_LOG_LEVEL=INFO
CONSUMER_LOG_LEVEL=INFO
